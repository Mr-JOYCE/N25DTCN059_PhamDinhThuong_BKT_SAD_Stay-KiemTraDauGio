        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam DefaultTextAlignment center\nskinparam monochrome true\nskinparam ActivityBackgroundColor white\nskinparam ActivityBorderColor black\nskinparam ArrowColor black\nskinparam Padding 10\nskinparam NodePadding 10\n\ntitle SƠ ĐỒ HOẠT ĐỘNG (ACTIVITY DIAGRAM) - NGHIỆP VỤ ĐẶT PHÒNG &amp; HỦY PHÒNG\n\nstart\n\n|Khách hàng|\n:Chọn chức năng cần thực hiện;\n\nif (Loại nghiệp vụ?) then (Đặt phòng)\n    :Nhập thông tin đặt phòng\\n(Mã phòng, Ngày nhận, Ngày trả);\n    \n    |Hệ thống|\n    :Kiểm tra định dạng ngày\\n&amp; sự tồn tại của phòng;\n    \n    if (Dữ liệu hợp lệ?) then (Không hợp lệ)\n        :Ghi nhận lỗi dữ liệu;\n        :Trả về thông báo lỗi\\n\&quot;Dữ liệu không hợp lệ\&quot;;\n        stop\n    else (Hợp lệ)\n        :Truy vấn CSDL kiểm tra\\nchiếm dụng phòng theo khoảng ngày;\n        \n        if (Trùng ngày đặt phòng?) then (Có trùng)\n            :Từ chối yêu cầu đặt phòng;\n            :Thông báo lỗi:\\n\&quot;Trùng ngày đặt phòng\&quot;;\n            stop\n        else (Không trùng)\n            :Tạo phiếu đặt phòng mới\\nLưu thông tin vào CSDL;\n            :Hiển thị xác nhận:\\n- Trạng thái: THÀNH CÔNG\\n- Dữ liệu trả về: Chi tiết phiếu;\n            stop\n        endif\n    endif\n\nelse (Hủy phòng)\n    |Khách hàng|\n    :Nhập mã phiếu đặt phòng cần hủy;\n    \n    |Hệ thống|\n    :Tìm kiếm mã phiếu trong CSDL;\n    \n    if (Mã phiếu tồn tại?) then (Không tồn tại)\n        :Dừng quy trình hủy phòng;\n        :Thông báo lỗi:\\n\&quot;Không tìm thấy phiếu\&quot;;\n        stop\n    else (Tồn tại)\n        :Thực hiện hủy phiếu đặt phòng\\nCập nhật trạng thái CSDL;\n        :Hiển thị xác nhận:\\n- Trạng thái: THÀNH CÔNG\\n- Dữ liệu trả về: Xác nhận hủy;\n        stop\n    endif\nendif\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="z-jKwpXVHKYFv4_tGMWG-74">
